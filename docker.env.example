# =============================================================
#  Sultan Cell - Konfigurasi Docker
#  Salin file ini menjadi `.env` lalu ubah sesuai kebutuhan.
#    copy docker.env.example .env   (Windows)
#  Nilai default aman untuk pemakaian lokal.
# =============================================================

# Port aplikasi di komputer/laptop Anda
APP_PORT=8080

# Nama & pengaturan aplikasi
APP_NAME=Sultan Cell
APP_ENV=production
APP_DEBUG=false
# APP_URL diisi URL cloudflared (misal https://xxx.trycloudflare.com) bila sudah ada
APP_URL=http://localhost:8080

# Database
DB_DATABASE=sistem_project1
DB_USERNAME=sultan
DB_PASSWORD=sultan123
DB_ROOT_PASSWORD=root123

# Cloudflared
# 1. BIARKAN KOSONG  -> menggunakan Quick Tunnel (trycloudflare.com), URL acak.
# 2. ISI dgn token   -> menggunakan tunnel permanen yang dikelola dashboard Cloudflare:
#    TUNNEL_TOKEN=eyJ...
TUNNEL_TOKEN=

# (Opsional) Kunci aplikasi; kosongkan agar dibuat otomatis saat pertama kali jalan.
# Set agar tetap sama di beberapa proses/redeploy:
#   php artisan key:generate --show  -> salin hasilnya ke sini
APP_KEY=